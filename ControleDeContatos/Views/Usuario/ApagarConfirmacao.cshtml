@model UsuarioModel
@{
    ViewData["Title"] = "Confirmação de apagar o usuário";
}

<div class="text-center">
    <h3>Realmente deseja apagar o usuário (@Model.Nome)?</h3>
</div>

<div class="d-flex justify-content-center">
    <a class="btn btn-primary" role="button" asp-action="Index" asp-controller="Usuario">Cancelar exclusão</a>
    <a class="btn btn-danger" role="button" asp-action="Apagar" asp-route-id="@Model.Id" asp-controller="Usuario">Confirmar exclusão</a>
</div>