@model List<UsuarioModel>
@{
    ViewData["Title"] = "Lista de Usuários";
}

<div class="text-start mb-4">
    <a class="btn btn-primary" role="button" asp-controller="Usuario" asp-action="Criar">Adicionar Usuário</a>
</div>

@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["MensagemSucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["MensagemErro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        @TempData["MensagemErro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="text-center mb-4">
    <h1 class="display-4">Lista de Usuários</h1>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover display" id="table-usuarios" style="width:100%">
        <thead>
            <tr>
                <th scope="col" class="text-center" style="width: 5%">#</th>
                <th scope="col">Nome</th>
                <th scope="col">Login</th>
                <th scope="col">E-mail</th>
                <th scope="col">Perfil</th>
                <th scope="col">Total</th>
                <th scope="col">Data de Cadastro</th>
                <th scope="col" class="text-center" style="width: 15%">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (UsuarioModel usuario in Model)
                {
                    <tr>
                        <th scope="row" class="text-center">@usuario.Id</th>
                        <td>@usuario.Nome</td>
                        <td>@usuario.Login</td>
                        <td>@usuario.Email</td>
                        <td>
                            <span class="badge @(usuario.Perfil == ControleDeContatos.Enum.PerfilEnum.Admin ? "bg-success" : "bg-secondary")">
                                @(usuario.Perfil == ControleDeContatos.Enum.PerfilEnum.Admin ? "Administrador" : "Padrão")
                            </span>
                        </td>
                        <td>
                            <a href="javascript:" usuario-id="@usuario.Id" class="btn btn-success btn-sm btn-total-contatos">
                                @(usuario.Contatos != null && usuario.Contatos.Any() ? usuario.Contatos.Count() : 0)
                            </a>
                        </td>
                        <td>@usuario.DataCadastro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a role="button" class="btn btn-sm btn-primary" asp-route-id="@usuario.Id" asp-controller="Usuario" asp-action="Editar">Editar</a>
                                <a role="button" class="btn btn-sm btn-danger" asp-route-id="@usuario.Id" asp-controller="Usuario" asp-action="ApagarConfirmacao">Apagar</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td valign="top" colspan="4" class="text-center text-muted">Nenhum usuário encontrado</td>
                </tr>
            }
        </tbody>
    </table>

    <div id="modalContatosUsuario" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Listagem de contatos</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="listaContatosUsuario">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
