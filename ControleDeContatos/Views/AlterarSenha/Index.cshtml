@model AlterarSenhaModel
@{
    ViewData["Title"] = "Alterar Senha";
}

<div class="text-center mb-4">
    <h1 class="display-4">Alterar Senha</h1>
</div>

@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["MensagemSucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["MensagemErro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        @TempData["MensagemErro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-controller="AlterarSenha" asp-action="Alterar" method="post">
    <div class="mb-3">
        <label asp-for="SenhaAtual" class="form-label">Senha Atual</label>
        <input type="password" asp-for="SenhaAtual" class="form-control" placeholder="Digite a senha atual do usuário">
        <span asp-validation-for="SenhaAtual" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NovaSenha" class="form-label">Nova Senha</label>
        <input type="password" asp-for="NovaSenha" class="form-control" placeholder="Digite a nova senha do usuário">
        <span asp-validation-for="NovaSenha" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmarNovaSenha" class="form-label">Confirme Nova Senha</label>
        <input type="password" asp-for="ConfirmarNovaSenha" class="form-control" placeholder="Digite a confirmação da nova senha do usuário">
        <span asp-validation-for="ConfirmarNovaSenha" class="text-danger"></span>
    </div>

    <div class="d-grid gap-2">
        <button type="submit" class="btn btn-primary">Alterar</button>
        <a class="btn btn-secondary" asp-action="Index" asp-controller="Home" role="button">Voltar</a>
    </div>
</form>
